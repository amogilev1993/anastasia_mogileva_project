<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/university.owl"
         xmlns="http://example.org/university.owl#">

<owl:Ontology rdf:about="http://example.org/university.owl"/>

<owl:ObjectProperty rdf:about="#memberOf">
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="#AcademicUnit"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#partOf">
  <rdfs:domain rdf:resource="#Department"/>
  <rdfs:range rdf:resource="#Faculty"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#teaches">
  <rdfs:domain rdf:resource="#AcademicStaff"/>
  <rdfs:range rdf:resource="#Course"/>
  <owl:inverseOf rdf:resource="#taughtBy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#taughtBy">
  <rdfs:domain rdf:resource="#Course"/>
  <rdfs:range rdf:resource="#AcademicStaff"/>
  <owl:inverseOf rdf:resource="#teaches"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#enrolledIn">
  <rdfs:domain rdf:resource="#Student"/>
  <rdfs:range rdf:resource="#Course"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#supervises">
  <rdfs:domain rdf:resource="#Professor"/>
  <rdfs:range rdf:resource="#PhDStudent"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#offeredBy">
  <rdfs:domain rdf:resource="#Course"/>
  <rdfs:range rdf:resource="#Department"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasAuthor">
  <rdfs:domain rdf:resource="#Publication"/>
  <rdfs:range rdf:resource="#Person"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#worksOnProject">
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="#Project"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#heldIn">
  <rdfs:domain rdf:resource="#Course"/>
  <rdfs:range rdf:resource="#Room"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasName">
  <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasEmail">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasAge">
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasCredits">
  <rdfs:domain rdf:resource="#Course"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasYear">
  <rdfs:domain rdf:resource="#Publication"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Person">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#AcademicUnit">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Course">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#taughtBy"/>
      <owl:onClass rdf:resource="#AcademicStaff"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Publication">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Project">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Room">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Student">
  <rdfs:subClassOf rdf:resource="#Person"/>
  <owl:disjointWith rdf:resource="#AcademicStaff"/>
</owl:Class>

<owl:Class rdf:about="#UndergraduateStudent">
  <rdfs:subClassOf rdf:resource="#Student"/>
</owl:Class>

<owl:Class rdf:about="#GraduateStudent">
  <rdfs:subClassOf rdf:resource="#Student"/>
</owl:Class>

<owl:Class rdf:about="#MasterStudent">
  <rdfs:subClassOf rdf:resource="#GraduateStudent"/>
</owl:Class>

<owl:Class rdf:about="#PhDStudent">
  <rdfs:subClassOf rdf:resource="#GraduateStudent"/>
</owl:Class>

<owl:Class rdf:about="#AcademicStaff">
  <rdfs:subClassOf rdf:resource="#Person"/>
</owl:Class>

<owl:Class rdf:about="#Professor">
  <rdfs:subClassOf rdf:resource="#AcademicStaff"/>
</owl:Class>

<owl:Class rdf:about="#Lecturer">
  <rdfs:subClassOf rdf:resource="#AcademicStaff"/>
</owl:Class>

<owl:Class rdf:about="#AdministrativeStaff">
  <rdfs:subClassOf rdf:resource="#Person"/>
</owl:Class>

<owl:Class rdf:about="#Department">
  <rdfs:subClassOf rdf:resource="#AcademicUnit"/>
</owl:Class>

<owl:Class rdf:about="#Faculty">
  <rdfs:subClassOf rdf:resource="#AcademicUnit"/>
</owl:Class>

<owl:Class rdf:about="#UndergraduateCourse">
  <rdfs:subClassOf rdf:resource="#Course"/>
</owl:Class>

<owl:Class rdf:about="#GraduateCourse">
  <rdfs:subClassOf rdf:resource="#Course"/>
</owl:Class>

<owl:Class rdf:about="#Article">
  <rdfs:subClassOf rdf:resource="#Publication"/>
</owl:Class>

<owl:Class rdf:about="#Book">
  <rdfs:subClassOf rdf:resource="#Publication"/>
</owl:Class>

<owl:Class rdf:about="#Classroom">
  <rdfs:subClassOf rdf:resource="#Room"/>
</owl:Class>

<owl:Class rdf:about="#Lab">
  <rdfs:subClassOf rdf:resource="#Room"/>
</owl:Class>

