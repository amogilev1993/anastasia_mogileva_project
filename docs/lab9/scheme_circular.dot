digraph CrimeScheme {
    graph [layout=circo, mindist=0.7, overlap=false, splines=true,
           fontname="DejaVu Sans", bgcolor="white", pad=0.4, dpi=150];
    node  [fontname="DejaVu Sans", fontsize=11, style="filled", penwidth=1.4];
    edge  [fontname="DejaVu Sans", fontsize=9, color="#555555", penwidth=1.3];

    /* ===== ПЕРСОНАЖИ — подозреваемые / преступники (синие овалы) ===== */
    Walt   [label="Уолтер Уайт\n«Хайзенберг»\n(организатор)", shape=ellipse, fillcolor="#BBD7F2", penwidth=2.4, color="#1A5FB4"];
    Jesse  [label="Джесси Пинкман\n(сообщник, повар)", shape=ellipse, fillcolor="#BBD7F2"];
    Skyler [label="Скайлер Уайт\n(отмывание денег)", shape=ellipse, fillcolor="#BBD7F2"];
    Saul   [label="Сол Гудман\n(адвокат, прикрытие)", shape=ellipse, fillcolor="#BBD7F2"];
    Gus    [label="Густаво Фринг\n(дистрибьютор)", shape=ellipse, fillcolor="#BBD7F2"];
    Mike   [label="Майк Эрмантраут\n(охрана, «решала»)", shape=ellipse, fillcolor="#BBD7F2"];
    Lydia  [label="Лидия\n(поставщик сырья)", shape=ellipse, fillcolor="#BBD7F2"];
    Jack   [label="Банда Джека\n(наёмники)", shape=ellipse, fillcolor="#BBD7F2"];
    Hector [label="Гектор Саламанка\n(картель)", shape=ellipse, fillcolor="#BBD7F2"];

    /* ===== ДЕТЕКТИВ / DEA (золотой) ===== */
    Hank   [label="Хэнк Шрейдер\n(агент DEA, детектив)", shape=ellipse, fillcolor="#FFE08A", penwidth=2.4, color="#B8860B"];

    /* ===== ЖЕРТВЫ (серые) ===== */
    Gale   [label="Гейл Боттикер\n(химик, жертва)", shape=ellipse, fillcolor="#D9D9D9"];
    Brock  [label="Брок\n(ребёнок, жертва)", shape=ellipse, fillcolor="#D9D9D9"];

    /* ===== СОБЫТИЯ (красные ромбы) ===== */
    Cook   [label="Производство\n«голубого мета»", shape=diamond, fillcolor="#F8B5B0", height=1.1, width=1.8];
    KillGale [label="Убийство\nГейла", shape=diamond, fillcolor="#F8B5B0", height=1.0, width=1.4];
    Poison [label="Отравление\nБрока (рицин)", shape=diamond, fillcolor="#F8B5B0", height=1.0, width=1.5];
    Blast  [label="Взрыв в доме\nпрестарелых\n(гибель Гуса)", shape=diamond, fillcolor="#F8B5B0", height=1.2, width=1.8];
    KillHank [label="Гибель\nХэнка", shape=diamond, fillcolor="#F8B5B0", height=1.0, width=1.4];

    /* ===== ДОКАЗАТЕЛЬСТВА / УЛИКИ (зелёные прямоугольники) ===== */
    BlueMeth [label="Голубой\nметамфетамин\n(фирменная улика)", shape=box, fillcolor="#BFE3B6"];
    Book     [label="Книга «Leaves of\nGrass» с подписью\n«G.B.»", shape=box, fillcolor="#BFE3B6"];
    Ricin    [label="Рицин\n(капсула-яд)", shape=box, fillcolor="#BFE3B6"];
    Lab      [label="Суперлаборатория\nпод прачечной /\nфургон RV", shape=box, fillcolor="#BFE3B6"];
    Methylamine [label="Метиламин\n(сырьё)", shape=box, fillcolor="#BFE3B6"];
    Money    [label="Деньги /\nавтомойка A1\n(легализация)", shape=box, fillcolor="#BFE3B6"];

    /* ===== СВЯЗИ ===== */
    /* Ядро преступной группы */
    Walt -> Jesse  [label="партнёры по\nпроизводству", dir=both, color="#1A5FB4", penwidth=2.0];
    Walt -> Skyler [label="муж / жена,\nотмывание", dir=both];
    Walt -> Saul   [label="клиент —\nадвокат", dir=both];
    Saul -> Mike   [label="связал с\n«решалой»", style=dashed];
    Walt -> Gus    [label="нанят как\nповар", dir=both];
    Gus  -> Mike   [label="работодатель", dir=both];
    Gus  -> Lydia  [label="канал\nпоставок", dir=both];
    Lydia -> Methylamine [label="поставляет"];
    Methylamine -> Cook  [label="сырьё", style=dashed];

    /* Производство и продукт */
    Walt  -> Cook  [label="организует", penwidth=1.8];
    Jesse -> Cook  [label="варит"];
    Cook  -> BlueMeth [label="продукт", penwidth=1.8];
    Cook  -> Lab   [label="место\nпреступления"];
    Gus   -> BlueMeth [label="сбыт", style=dashed];
    Skyler -> Money [label="легализует"];
    Walt  -> Money [label="доход от\nпродаж"];

    /* Убийство Гейла */
    Gus   -> Gale  [label="нанял\nхимиком"];
    Walt  -> KillGale [label="заказал\n(чтобы стать\nнезаменимым)", color="#C01C28", penwidth=1.8];
    Jesse -> KillGale [label="исполнитель", color="#C01C28"];
    KillGale -> Gale [label="жертва", color="#C01C28"];

    /* Отравление Брока — манипуляция */
    Walt  -> Poison [label="организовал", color="#C01C28", penwidth=1.8];
    Poison -> Ricin [label="орудие"];
    Poison -> Brock [label="жертва", color="#C01C28"];
    Poison -> Jesse [label="манипуляция\n(подставил Гуса)", style=dashed, color="#C01C28"];

    /* Устранение Гуса */
    Walt  -> Blast [label="спланировал", color="#C01C28", penwidth=1.8];
    Hector -> Blast [label="привёл в\nдействие бомбу", color="#C01C28"];
    Blast -> Gus   [label="гибель", color="#C01C28"];

    /* Расследование DEA */
    Hank -> Walt   [label="зять\n(родство)", dir=both, color="#B8860B", style=dashed];
    Hank -> BlueMeth [label="расследует\nисточник", color="#B8860B", penwidth=1.6];
    Hank -> Gus    [label="подозревал", color="#B8860B", style=dashed];
    Book -> Hank   [label="ключевая улика:\nразоблачение\nХайзенберга", color="#B8860B", penwidth=2.0];
    Walt -> Book   [label="оставил дома"];
    Gale -> Book   [label="дарственная\nнадпись «G.B.»", style=dashed];

    /* Финал */
    Hank -> Jack   [label="перестрелка", color="#C01C28", style=dashed];
    Jack -> KillHank [label="исполнитель", color="#C01C28"];
    KillHank -> Hank [label="жертва", color="#C01C28"];
}
