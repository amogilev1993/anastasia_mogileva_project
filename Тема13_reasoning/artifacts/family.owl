<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/family.owl"
         xmlns="http://example.org/family.owl#">

<owl:Ontology rdf:about="http://example.org/family.owl"/>

<owl:ObjectProperty rdf:about="#hasAncestor">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="#Person"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasParent">
  <rdfs:subPropertyOf rdf:resource="#hasAncestor"/>
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="#Person"/>
  <owl:inverseOf rdf:resource="#hasChild"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasChild">
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="#Person"/>
  <owl:inverseOf rdf:resource="#hasParent"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasSibling">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="#Person"/>
</owl:ObjectProperty>

<owl:Class rdf:about="#Person">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Male">
  <rdfs:subClassOf rdf:resource="#Person"/>
  <owl:disjointWith rdf:resource="#Female"/>
</owl:Class>

<owl:Class rdf:about="#Female">
  <rdfs:subClassOf rdf:resource="#Person"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#Anna">
  <rdf:type rdf:resource="#Female"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Анна</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Boris">
  <rdf:type rdf:resource="#Male"/>
  <hasParent rdf:resource="#Anna"/>
  <hasSibling rdf:resource="#Clara"/>
  <hasAncestor rdf:resource="#Anna"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Борис</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Clara">
  <rdf:type rdf:resource="#Female"/>
  <hasParent rdf:resource="#Anna"/>
  <hasAncestor rdf:resource="#Anna"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Клара</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Dmitry">
  <rdf:type rdf:resource="#Male"/>
  <hasParent rdf:resource="#Boris"/>
  <hasAncestor rdf:resource="#Anna"/>
  <hasAncestor rdf:resource="#Boris"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дмитрий</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Elena">
  <rdf:type rdf:resource="#Female"/>
  <hasParent rdf:resource="#Clara"/>
  <hasAncestor rdf:resource="#Anna"/>
  <hasAncestor rdf:resource="#Clara"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Елена</rdfs:label>
</owl:NamedIndividual>


</rdf:RDF>
